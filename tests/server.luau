local fs = require("@sonata/fs")
local path = require("@sonata/path")
local task = require("@sonata/task")
local t = require("./lib")
local server = require("../server")
local request = require("../request")
local websocket = require("../websocket")
local sse = require("../sse")

return function()
	t.section("server")

	local app = server.app({ logErrors = false })
	local mw = server.middleware
	local log = {}
	app:use(mw.logger({ write = function(line) table.insert(log, line) end }))
	app:get("/", function()
		return "<h1>home</h1>"
	end)
	app:get("/text", function()
		return "plain"
	end)
	app:get("/users/:id(%d+)", function(req)
		return { id = req.params.id, sort = req.query.sort }
	end)
	app:post("/echo", function(req, res)
		res:status(201):json({ got = req:json(), type = req.headers["content-type"] })
	end)
	app:put("/form", function(req)
		return req:form()
	end)
	app:get("/tuple", function()
		return 202, "accepted", { ["x-extra"] = "yes" }
	end)
	app:get("/boom", function()
		error("kaboom")
	end)
	app:get("/teapot", function()
		server.abort(418, "short and stout")
	end)
	app:get("/cookie", function(req, res)
		res:cookie("session", "abc", { maxAge = 60 })
		return { seen = req.cookies.session }
	end)
	app:get("/stream", function(req, res)
		for i = 1, 3 do
			res:write(`part{i};`)
		end
		res:finish()
	end)
	app:get("/files/*rest", function(req)
		return req.params.rest
	end)
	app:group("/api", function(api)
		api:use(function(req, res, nextFn)
			res:header("x-api", "1")
			nextFn()
		end)
		api:get("/health", function(req)
			return { ok = true, base = req.baseUrl, path = req.path }
		end)
	end)
	local big = string.rep("compress me ", 500)
	app:get("/big", mw.compress(), function()
		return big
	end)
	app:use("/admin", mw.basicAuth({ users = { admin = "pw" } }))
	app:get("/admin/panel", function(req)
		return `hello {req.locals.user}`
	end)

	-- Static files in a temp folder
	local dir = fs.makeTempDir("httpx-test-")
	fs.writeFile(path.join(dir, "index.html"), "<p>index</p>")
	fs.writeFile(path.join(dir, "about.html"), "<p>about</p>")
	fs.writeFile(path.join(dir, "data.txt"), "0123456789")
	fs.writeFile(path.join(dir, ".secret"), "nope")
	fs.makeDir(path.join(dir, "sub"))
	fs.writeFile(path.join(dir, "sub", "a.css"), "body{}")
	app:static("/site", dir, { extensions = { "html" }, listing = true })

	-- WebSocket echo and SSE
	local room = websocket.hub()
	app:ws("/ws", function(ws)
		room:add(ws)
		for message, kind in ws:messages() do
			ws:send("echo:" .. message, kind)
		end
	end, { protocols = { "chat" } })
	app:get("/events", function(req, res)
		local stream = res:sse({ keepAlive = 0 })
		stream:send("first")
		stream:send({ n = 2 }, { event = "update", id = 7 })
		stream:send("multi\nline")
		stream:close()
	end)

	local srv = assert(app:listen({ port = 0, host = "127.0.0.1" }))
	local base = `http://127.0.0.1:{srv.port}`
	local http = request.client({ baseUrl = base })

	t.test("html and text responses", function()
		local res = assert(http:get("/"))
		t.eq(res.status, 200)
		t.contains(res.headers["content-type"], "text/html")
		t.eq(res.body, "<h1>home</h1>")
		res = assert(http:get("/text"))
		t.contains(res.headers["content-type"], "text/plain")
	end)

	t.test("route params with constraints and query", function()
		local data = assert(assert(http:get("/users/42", { query = { sort = "name" } })):json())
		t.eq(data.id, "42")
		t.eq(data.sort, "name")
		t.eq(assert(http:get("/users/abc")).status, 404)
	end)

	t.test("json request and status", function()
		local res = assert(http:post("/echo", { json = { a = 1 } }))
		t.eq(res.status, 201)
		local data = assert(res:json())
		t.eq(data.got.a, 1)
		t.eq(data.type, "application/json")
	end)

	t.test("invalid json gives 400", function()
		local res = assert(http:post("/echo", { body = "{nope", headers = { ["content-type"] = "application/json" } }))
		t.eq(res.status, 400)
	end)

	t.test("form bodies", function()
		local data = assert(assert(http:put("/form", { form = { name = "a b", x = "1" } })):json())
		t.eq(data.name, "a b")
		t.eq(data.x, "1")
	end)

	t.test("tuple returns", function()
		local res = assert(http:get("/tuple"))
		t.eq(res.status, 202)
		t.eq(res.body, "accepted")
		t.eq(res.headers["x-extra"], "yes")
	end)

	t.test("errors become 500 / custom statuses", function()
		local res = assert(http:get("/boom"))
		t.eq(res.status, 500)
		t.eq(res.body, "Internal Server Error")
		res = assert(http:get("/teapot", { headers = { accept = "application/json" } }))
		t.eq(res.status, 418)
		t.eq(assert(res:json()).error, "short and stout")
	end)

	t.test("404, 405 and OPTIONS", function()
		t.eq(assert(http:get("/nope")).status, 404)
		local res = assert(http:delete("/text"))
		t.eq(res.status, 405)
		t.contains(res.headers.allow, "GET")
		res = assert(http:options("/text"))
		t.eq(res.status, 204)
	end)

	t.test("HEAD has no body", function()
		local res = assert(http:head("/text"))
		t.eq(res.status, 200)
		t.eq(res.body, "")
		t.eq(res.headers["content-length"], "5")
	end)

	t.test("cookies round trip through the client jar", function()
		local first = assert(assert(http:get("/cookie")):json())
		t.eq(first.seen, nil)
		local second = assert(assert(http:get("/cookie")):json())
		t.eq(second.seen, "abc")
	end)

	t.test("the shared client keeps no cookies between calls", function()
		t.eq(assert(assert(request.get(base .. "/cookie")):json()).seen, nil)
		t.eq(assert(assert(request.get(base .. "/cookie")):json()).seen, nil)
	end)

	t.test("chunked streaming responses", function()
		local res = assert(http:get("/stream"))
		t.eq(res.headers["transfer-encoding"], "chunked")
		t.eq(res.body, "part1;part2;part3;")
	end)

	t.test("wildcards and groups", function()
		t.eq(assert(http:get("/files/a/b/c.txt")).body, "a/b/c.txt")
		local res = assert(http:get("/api/health"))
		t.eq(res.headers["x-api"], "1")
		local data = assert(res:json())
		t.eq(data.base, "/api")
		t.eq(data.path, "/health")
	end)

	t.test("compression", function()
		local res = assert(http:get("/big"))
		t.ok(res.headers["content-encoding"] ~= nil, "content-encoding set")
		t.eq(res.body, big)
		local raw = assert(http:get("/big", { decompress = false, headers = { ["accept-encoding"] = "gzip" } }))
		t.eq(raw.headers["content-encoding"], "gzip")
		t.ok(#raw.body < #big, "compressed is smaller")
	end)

	t.test("basic auth", function()
		local res = assert(http:get("/admin/panel"))
		t.eq(res.status, 401)
		t.contains(res.headers["www-authenticate"], "Basic")
		res = assert(http:get("/admin/panel", { auth = { "admin", "pw" } }))
		t.eq(res.body, "hello admin")
	end)

	t.test("static files", function()
		t.eq(assert(http:get("/site/")).body, "<p>index</p>")
		local res = assert(http:get("/site", { followRedirects = false }))
		t.eq(res.status, 301)
		t.eq(res.headers.location, "/site/")
		t.eq(assert(http:get("/site/about")).body, "<p>about</p>")
		t.eq(assert(http:get("/site/.secret")).status, 404)
		t.eq(assert(http:get("/site/..%2f..%2fetc%2fpasswd")).status, 403)
		res = assert(http:get("/site/sub/a.css"))
		t.contains(res.headers["content-type"], "text/css")
		local etag = res.headers.etag
		t.ok(etag, "etag")
		t.eq(assert(http:get("/site/sub/a.css", { headers = { ["if-none-match"] = etag } })).status, 304)
		t.contains(assert(http:get("/site/sub/")).body, "a.css")
	end)

	t.test("byte ranges", function()
		local res = assert(http:get("/site/data.txt", { headers = { range = "bytes=2-4" } }))
		t.eq(res.status, 206)
		t.eq(res.body, "234")
		t.eq(res.headers["content-range"], "bytes 2-4/10")
		res = assert(http:get("/site/data.txt", { headers = { range = "bytes=-3" } }))
		t.eq(res.body, "789")
		t.eq(assert(http:get("/site/data.txt", { headers = { range = "bytes=50-" } })).status, 416)
	end)

	t.test("websocket echo, subprotocols and hub", function()
		local ws = assert(websocket.connect(`ws://127.0.0.1:{srv.port}/ws`, { protocols = { "chat" } }))
		t.eq(ws.protocol, "chat")
		ws:send("hi")
		local data, kind = ws:recv(5)
		t.eq(data, "echo:hi")
		t.eq(kind, "text")
		ws:sendBinary("\0\1\2")
		data, kind = ws:recv(5)
		t.eq(data, "echo:\0\1\2")
		t.eq(kind, "binary")
		local big = string.rep("x", 200000)
		ws:send(big)
		t.eq(ws:recv(5), "echo:" .. big)
		t.eq(room:count(), 1)
		ws:close(1000, "bye")
		t.ok(ws.closed, "closed")
		t.eq(ws.closeCode, 1000)
		task.wait(0.05)
		t.eq(room:count(), 0)
	end)

	t.test("plain GET to a websocket route gets 426", function()
		t.eq(assert(http:get("/ws")).status, 426)
	end)

	t.test("server-sent events", function()
		local events = {}
		local source = sse.connect(base .. "/events", { reconnect = false })
		for event in source:events() do
			table.insert(events, event)
		end
		t.eq(#events, 3)
		t.eq(events[1].data, "first")
		t.eq(events[2].event, "update")
		t.eq(events[2].data, '{"n":2}')
		t.eq(events[2].id, "7")
		t.eq(events[3].data, "multi\nline")
	end)

	t.test("logger saw requests", function()
		t.ok(#log > 10, "log lines")
		t.contains(log[1], "GET")
	end)

	srv:close()
	fs.removeDir(dir, true)
end
